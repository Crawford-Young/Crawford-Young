exports[`renderLanguagesCard > shows language names and percentages 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" width="375" height="195" viewBox="0 0 375 195" fill="none" role="img" aria-label="Top Languages">
  <rect width="374" height="194" x="0.5" y="0.5" rx="8" fill="#18181b" stroke="#27272a"/>
  <text x="24" y="33" fill="#fafafa" font-family="-apple-system, 'Segoe UI', system-ui, sans-serif" font-size="16" font-weight="600">Top Languages</text>
  <clipPath id="lang-bar"><rect x="24" y="52" width="327" height="8" rx="4"/></clipPath>
  <rect x="24" y="52" width="327" height="8" rx="4" fill="#27272a"/>
  <g clip-path="url(#lang-bar)">
    <rect x="24.0" y="52" width="228.9" height="8" fill="#3178c6"/>
